# Copy this file to ~/.config/garmin-coach/.env and fill in your real Garmin
# Connect credentials. Never commit the real .env file — it's already covered
# by .gitignore.
#
#   mkdir -p ~/.config/garmin-coach
#   cp skills/garmin_coach_mcp/.env.example ~/.config/garmin-coach/.env
#   # then edit ~/.config/garmin-coach/.env with your real values

# Your Garmin Connect login — this is your email, but the variable name is
# GARMIN_USERNAME (that's what garmin_client.py reads).
GARMIN_USERNAME=your@email.com
GARMIN_PASSWORD=yourpassword

# Optional — only needed for weather_adjuster.py's live forecast lookup.
# Without it, weather_adjuster.py falls back to seasonal climate estimates.
OPENWEATHER_API_KEY=
