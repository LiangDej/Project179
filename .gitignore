# Credentials — absolute ban
.env
*.env
.env.*
!.env.example
credentials.json
token.json

# Python environments (platform-specific, never commit)
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
.venv-linux/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
Icon?
._*
Thumbs.db

# Large Garmin activity dump (regenerated from Garmin Connect, not source of truth)
GarminRawData/running_activities_all.json
GarminRawData/running_activities_all.json.sha256

# Garmin health/lap cache (lives in ~/.config/garmin-coach/ but just in case)
health_cache/
lap_cache/

# Per-activity session cache (regenerated from Garmin, not source of truth)
GarminRawData/SessionCache/

# Personal athlete data — copy *.example.json → *.json and fill in your values
GarminRawData/athlete.json
GarminRawData/races.json

# Personal training logs (generated locally, never committed)
GarminRawData/QualitySessionLog/
GarminRawData/QualityDetails/
GarminRawData/RaceHistory/
GarminRawData/coaching_log.md

# Personal training plan — contains actual VDOT/CTL/race targets
GarminRawData/MASTER_PLAN_2026.md

# Personal daily wellness data (sleep/HRV/BB) — same sensitivity as athlete.json
GarminRawData/wellness/

# Third-party (partner/friend) Garmin wellness data — someone else's personal
# health data, never belongs in this repo's history under any circumstances.
GarminRawData/wellness_partner/

# VME lab / customer infra project — separate from the running-coach project,
# contains plaintext lab credentials and customer environment details.
# Never belongs in this repo's history.
GarminRawData/lab_envs.py
GarminRawData/deploy_vm.py
GarminRawData/VME-Training-Lab-Runbook.md
GarminRawData/ha_failover_report_*.md

# Unrelated personal projects living in this same working directory — never
# part of the Garmin running-coach agent, must never be pushed with it.
PalatinoseLab/
skills/investment-coach.md

# Claude Code session data (local tooling, not project source)
.claude/

# garmin_coach_mcp has its own local git repo — track only the two needed files
# (config.py and db_helper.py are added explicitly above)
skills/garmin_coach_mcp/__pycache__/
